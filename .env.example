# Copy to .env in this folder (backend/) and set real values. Do not commit .env.

# Public SPA URL used in password-reset and welcome emails (no trailing slash).
FRONTEND_PUBLIC_URL=http://127.0.0.1:5173

# Optional: print full SMTP Setting snapshots with each mail attempt (requires DEBUG=True or combine with SMTP logs).
# EMAIL_DEBUG=1

# Branded email logo: put JPG/PNG at media/assets/navlogo.jpg under backend/ (embedded inline; no public URL needed).
# Or set either path (relative to backend/ is OK):
# EMAIL_INLINE_LOGO_PATH=media/assets/navlogo.jpg
# EMAIL_HOST_USER_IMAGE=media/assets/navlogo.jpg
# If the file is missing on the server, use a public HTTPS image URL:
# PUBLIC_BRAND_LOGO_URL=https://example.com/static/navlogo.jpg

# SMTP (Spacemail)
EMAIL_HOST=mail.spacemail.com
EMAIL_PORT=465
EMAIL_HOST_USER=info@eurostar.land
EMAIL_HOST_PASSWORD=

# Bare mailbox address (same as EMAIL_HOST_USER unless you use a different From address)
DEFAULT_FROM_EMAIL=info@eurostar.land

# Shown as the sender name in the mail client (From: "Eurostar Group" <...>)
EMAIL_SENDER_NAME=Eurostar Group

# Optional: only if autodetection from EMAIL_PORT is wrong
# EMAIL_USE_TLS=0
# EMAIL_USE_SSL=1
